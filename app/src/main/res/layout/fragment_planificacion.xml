<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:text="Planifica tu ruta"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/textoPrincipal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Origen"
            android:textStyle="bold"
            android:textColor="@color/colorOrigen"
            android:layout_marginTop="20dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spLineaOrigen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_spinner_custom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <Spinner
            android:id="@+id/spEstacionOrigen"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_spinner_custom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <TextView
            android:text="Destino"
            android:textStyle="bold"
            android:textColor="@color/colorDestino"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/spLineaDestino"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_spinner_custom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>

        <Spinner
            android:id="@+id/spEstacionDestino"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_spinner_custom"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <Button
            android:id="@+id/btnBuscarRuta"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="36dp"
            android:text="BUSCAR RUTA"
            android:textAllCaps="true"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white"/>

        <ProgressBar
            android:id="@+id/progressBusqueda"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>