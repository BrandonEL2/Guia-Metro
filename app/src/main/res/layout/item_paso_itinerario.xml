<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Número de paso (Ej. 1., 2., 3.) -->
    <TextView
        android:id="@+id/txtNumeroPaso"
        android:layout_width="24dp"
        android:layout_height="wrap_content"
        android:text="1."
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Indicador visual (Punto y Línea conectora al estilo mapa) -->
    <View
        android:id="@+id/puntoEstacion"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/bg_punto_estacion"
        android:layout_marginStart="4dp"
        app:layout_constraintTop_toTopOf="@id/txtNombreEstacion"
        app:layout_constraintBottom_toBottomOf="@id/txtNombreEstacion"
        app:layout_constraintStart_toEndOf="@id/txtNumeroPaso"/>

    <View
        android:id="@+id/lineaConectora"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#2E7D32"
        app:layout_constraintTop_toBottomOf="@id/puntoEstacion"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/puntoEstacion"
        app:layout_constraintEnd_toEndOf="@id/puntoEstacion"/>

    <!-- Nombre de la Estación con su Línea -->
    <TextView
        android:id="@+id/txtNombreEstacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Indios Verdes (L3)"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/puntoEstacion"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Instrucción o detalle del paso -->
    <TextView
        android:id="@+id/txtInstruccionDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sube al Metro\nDirección: Universidad"
        android:textSize="13sp"
        android:textColor="#555555"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtNombreEstacion"
        app:layout_constraintStart_toEndOf="@id/puntoEstacion"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>