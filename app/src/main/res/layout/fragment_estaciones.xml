<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapa Interactivo de las Líneas del Metro CDMX"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:text="Consulta rutas, estaciones y conexiones de cada línea."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Barra de búsqueda -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchViewEstaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_icono_linea2"
            android:backgroundTint="#EAEAEA"
            app:iconifiedByDefault="false"
            app:queryHint="Buscar estación (ej. Bellas Artes)..." />

        <!-- Lista para mostrar los resultados de búsqueda -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResultadosBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Cuadrícula (GridLayout) de Líneas -->
