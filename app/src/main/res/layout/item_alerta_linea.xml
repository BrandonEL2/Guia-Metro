<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#B0B0B0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Cuadro contenedor del número/letra de la línea -->
        <FrameLayout
            android:id="@+id/contenedorCuadroLinea"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="#E91E63"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txtNumeroLinea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="1" />
        </FrameLayout>

        <!-- Nombre de la Línea (Ej. LÍNEA 1) -->
        <TextView
            android:id="@+id/txtNombreLinea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/contenedorCuadroLinea"
            app:layout_constraintStart_toEndOf="@id/contenedorCuadroLinea"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="LÍNEA 1" />

        <!-- Estado del servicio (Ej. SERVICIO REGULAR o AVANCE LENTO) -->
        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:textColor="#00C853"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/txtNombreLinea"
            app:layout_constraintStart_toEndOf="@id/contenedorCuadroLinea"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="SERVICIO REGULAR" />

        <!-- Estaciones afectadas -->
        <TextView
            android:id="@+id/txtEstacionesAfectadas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F2EBEB"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/contenedorCuadroLinea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="ESTACIONES AFECTADAS: Ninguna" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>