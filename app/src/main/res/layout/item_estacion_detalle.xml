<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Columna Visual: Líneas superior/inferior e indicador de punto -->
        <LinearLayout
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <View
                android:id="@+id/viewLineaArriba"
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@color/colorPrimary" />

            <View
                android:id="@+id/viewPuntoEstacion"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_punto_estacions" />

            <View
                android:id="@+id/viewLineaAbajo"
                android:layout_width="4dp"
                android:layout_height="18dp"
                android:background="@color/colorPrimary" />

        </LinearLayout>

        <!-- Columna Informativa: Nombre de la estación e Instrucción/Transbordo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreEstacionDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textoPrincipal"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="OBSERVATORIO" />

            <TextView
                android:id="@+id/txtCorrespondenciasDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#757575"
                android:textSize="14sp"
                tools:text="Sin correspondencias" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>