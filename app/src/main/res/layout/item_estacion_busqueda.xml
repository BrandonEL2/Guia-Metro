<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/fondo_tarjeta"
    app:cardCornerRadius="16dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Indicador con el ícono de la línea -->
        <FrameLayout
            android:id="@+id/contenedorCuadroLinea"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icono_linea">

            <TextView
                android:id="@+id/txtNumeroLinea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="3" />

        </FrameLayout>

        <!-- Información principal de la estación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreEstacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/textoPrincipal"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Indios Verdes" />

            <TextView
                android:id="@+id/txtDetalleLinea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/textoSubtitulo"
                android:textSize="14sp"
                tools:text="Línea 3 • Indios Verdes - Universidad" />

        </LinearLayout>

        <!-- Flecha indicadora -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/iconoTint" />

    </LinearLayout>

</androidx.cardview.widget.CardView>