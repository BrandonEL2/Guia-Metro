<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Cuadro con la forma oficial del Metro CDMX -->
        <FrameLayout
            android:id="@+id/contenedorCuadroLinea"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_icono_linea">

            <TextView
                android:id="@+id/txtNumeroLinea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="3" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreEstacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F2937"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Indios Verdes" />

            <TextView
                android:id="@+id/txtDetalleLinea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B7280"
                android:textSize="13sp"
                tools:text="Línea 3 • Indios Verdes - Universidad" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>