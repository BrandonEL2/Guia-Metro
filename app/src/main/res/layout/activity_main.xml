<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/fondo_pantalla">

    <!-- ENCABEZADO: ICONO, TÍTULO Y BOTÓN ALINEADOS A LA MISMA ALTURA -->
    <RelativeLayout
        android:id="@+id/encabezadoHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/btnOpciones"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <!-- Fila Horizontal para Icono + Título -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgHeaderIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:src="@android:drawable/ic_dialog_map"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtHeaderTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Planifica tu ruta"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtHeaderSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Selecciona un origen y un destino"
                android:textColor="#757575"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Botón de 3 Puntos -->
        <ImageButton
            android:id="@+id/btnOpciones"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert"
            app:tint="?android:attr/textColorPrimary" />
    </RelativeLayout>

    <!-- CONTENEDOR DE FRAGMENTS (Inicia justo debajo del encabezado) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"
        app:layout_constraintBottom_toTopOf="@id/miBarraInferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezadoHeader" />

    <!-- BARRA INFERIOR DE NAVEGACIÓN -->
    <LinearLayout
        android:id="@+id/miBarraInferior"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:background="@color/fondo_tarjeta"
        android:elevation="12dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- TAB: RUTA -->
        <LinearLayout
            android:id="@+id/btnTabRuta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabRuta"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="@color/tab_selector_color" />

            <TextView
                android:id="@+id/txtTabRuta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ruta"
                android:textColor="@color/tab_selector_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- TAB: ESTACIONES -->
        <LinearLayout
            android:id="@+id/btnTabEstaciones"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabEstaciones"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_mapmode"
                app:tint="@color/tab_selector_color" />

            <TextView
                android:id="@+id/txtTabEstaciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Estaciones"
                android:textColor="@color/tab_selector_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- TAB: ALERTAS -->
        <LinearLayout
            android:id="@+id/btnTabAlertas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabAlertas"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/tab_selector_color" />

            <TextView
                android:id="@+id/txtTabAlertas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Alertas"
                android:textColor="@color/tab_selector_color"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- TAB: MAPA -->
        <LinearLayout
            android:id="@+id/btnTabMapa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTabMapa"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_dialog_map"
                app:tint="@color/tab_selector_color" />

            <TextView
                android:id="@+id/txtTabMapa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Mapa"
                android:textColor="@color/tab_selector_color"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>