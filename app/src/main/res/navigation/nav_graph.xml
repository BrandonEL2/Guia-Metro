<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/rutaFragment">

    <!-- Pantalla de Planificación / Ruta -->
    <fragment
        android:id="@+id/rutaFragment"
        android:name="com.example.guiametro.RutaFragment"
        android:label="Planificar Ruta">
        <action
            android:id="@+id/action_planificacion_to_itinerario"
            app:destination="@id/itinerarioFragment" />
    </fragment>

    <!-- Pantalla de Resultados / Itinerario -->
    <fragment
        android:id="@+id/itinerarioFragment"
        android:name="com.example.guiametro.ItinerarioFragment"
        android:label="Itinerario" />

    <!-- Pantalla de Estaciones y Líneas -->
    <fragment
        android:id="@+id/estacionesFragment"
        android:name="com.example.guiametro.EstacionesFragment"
        android:label="Estaciones">
        <action
            android:id="@+id/action_estaciones_to_detalle"
            app:destination="@id/detalleLineaFragment" />
    </fragment>

    <!-- Detalle de Línea y Estaciones -->
    <fragment
        android:id="@+id/detalleLineaFragment"
        android:name="com.example.guiametro.DetalleLineaFragment"
        android:label="Detalle de Línea" />

    <!-- Pantalla de Alertas -->
    <fragment
        android:id="@+id/alertasFragment"
        android:name="com.example.guiametro.AlertasFragment"
        android:label="Alertas" />
    <!-- Pantalla de Mapa -->
    <fragment
        android:id="@+id/mapaFragment"
        android:name="com.example.guiametro.MapaFragment"
        android:label="Mapa" />
</navigation>